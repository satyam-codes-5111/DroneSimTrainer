# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE_URL: PostgreSQL connection string for production-grade observation report persistence.
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE_NAME>?sslmode=require
# Examples:
#   Local Docker: postgresql://postgres:postgres@localhost:5432/cuas_trainer
#   Cloud SQL / Supabase / Neon: postgresql://dbuser:password@ep-host.region.aws.neon.tech/neondb?sslmode=require
# When left empty or unset, the application automatically uses the verified local filesystem JSON document store (/data/observation_reports.json).
DATABASE_URL=""

# Authentication & Admin Bootstrap Security Configuration
# ADMIN_BOOTSTRAP_PASSWORD: Required in production when initializing initial personnel accounts into an empty users table.
# Startup fails safely if required credentials are missing in production.
ADMIN_BOOTSTRAP_PASSWORD=""
TRAINEE_BOOTSTRAP_PASSWORD=""
INSTRUCTOR_BOOTSTRAP_PASSWORD=""
COMMANDER_BOOTSTRAP_PASSWORD=""

# PostgreSQL TLS Verification Configuration
# PG_SSL_CA: Optional PEM content of trusted database Certificate Authority.
# PG_SSL_CA_PATH: Optional filesystem path to trusted CA bundle (defaults to ./certs/supabase-root-ca.pem if present).
# PG_SSL_REJECT_UNAUTHORIZED: "true" (default) strictly rejects unauthorized TLS certificates.
PG_SSL_CA=""
PG_SSL_CA_PATH="./certs/supabase-root-ca.pem"
PG_SSL_REJECT_UNAUTHORIZED="true"

